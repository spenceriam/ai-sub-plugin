# Preferred: ~/.config/ai-sub-monitor/keys.env (dir 0700, file 0600).
# Legacy: ~/.config/omarchy/ai-sub-monitor.env
# Existing environment variables win over this file. Do not put keys in shell.json.

# Kimi Code Console key — not a Moonshot PAYG wallet key.
KIMI_API_KEY=

# Z.AI / GLM Coding Plan key. Header is raw Authorization, not Bearer.
ZAI_API_KEY=
# Optional. Default https://api.z.ai  (China: https://open.bigmodel.cn)
# ZAI_HOST=

# MiniMax Token Plan Subscription Key — not a PAYG sk-api- key.
MINIMAX_API_KEY=
# Optional. Default https://api.minimax.io  (China: https://api.minimaxi.com)
# MINIMAX_HOST=

# Ollama Cloud key from https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Kilo Pass / Gateway key from the bottom of https://app.kilo.ai/profile
# (personal account, not a BYOK provider key).
KILO_API_KEY=
# Optional. Default https://api.kilo.ai  (tRPC also tried on https://app.kilo.ai)
# KILO_HOST=
# Optional organization id for a team wallet.
# KILO_ORG_ID=

# Command Code Studio API key — same key as the CLI (COMMAND_CODE_API_KEY).
# https://commandcode.ai (Studio → API Keys). Not a browser session cookie.
COMMAND_CODE_API_KEY=
# Optional. Default https://api.commandcode.ai
# COMMAND_CODE_HOST=
